{
  "name": "clickup-context-mcp",
  "version": "0.3.0",
  "description": "MCP server for ClickUp — full task context with screenshots as real vision, a computed critical path, Docs, Chat, and time tracking, on a personal API token.",
  "license": "MIT",
  "author": "Tsahi Elkayam <etsahi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tsahi-Elkayam/clickup-context-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Tsahi-Elkayam/clickup-context-mcp/issues"
  },
  "homepage": "https://github.com/Tsahi-Elkayam/clickup-context-mcp#readme",
  "type": "module",
  "bin": {
    "clickup-context-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/**/*.test.js",
    "handshake": "npm run build && node scripts/handshake.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "keywords": [
    "mcp",
    "clickup",
    "claude",
    "model-context-protocol",
    "screenshots",
    "vision",
    "critical-path",
    "gantt",
    "project-management"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
