{
  "name": "clickup-context-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives Claude full ClickUp task context in one call — description, comments, and screenshots rendered as real vision.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clickup-context-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/**/*.test.js"
  },
  "keywords": [
    "mcp",
    "clickup",
    "claude",
    "model-context-protocol",
    "screenshots",
    "vision"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
